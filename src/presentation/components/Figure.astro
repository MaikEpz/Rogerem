---
import type { Symbol } from '../../domain/destination';
interface Props { symbol: Symbol; class?: string }
const { symbol, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 200 200" fill="currentColor" aria-hidden="true">
  {symbol === 'flower' && <>
    <path d="M100 8C116 20 120 32 118 44C131 33 146 32 160 37C162 54 158 67 147 77C164 78 178 87 187 100C178 115 164 123 147 123C158 135 162 149 158 164C142 167 128 163 117 151C119 169 112 182 100 193C85 182 79 168 81 152C68 163 53 167 39 162C36 146 41 132 52 122C34 123 20 115 10 101C20 86 34 79 52 79C40 67 36 53 40 37C56 33 70 38 81 49C79 31 86 17 100 8Z"/>
    <path fill="var(--figure-cutout, #1c1d1b)" d="m100 66 9 17 18-6-5 18 16 10-18 7 3 19-18-8-12 14-4-20-20-1 12-15-10-16 20 2Z"/>
  </>}
  {symbol === 'star' && <path d="m100 7 26 61 66 6-50 44 15 66-57-35-57 35 15-66L8 74l66-6Z"/>}
  {symbol === 'eye' && <>
    <path d="M5 100S43 53 100 53s95 47 95 47-38 47-95 47S5 100 5 100Z"/>
    <circle cx="100" cy="100" r="35" fill="var(--figure-cutout, #1c1d1b)"/>
    <circle cx="100" cy="100" r="24"/>
    <circle cx="115" cy="85" r="12" fill="var(--figure-cutout, #1c1d1b)"/>
  </>}
  {symbol === 'moon' && <path d="M144 19a85 85 0 1 0 39 111A70 70 0 0 1 144 19Z"/>}
</svg>
